VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Production: set to "true" to fail fast in the browser if Supabase env is missing (recommended for Vercel).
# VITE_STRICT_ENV=true

# Optional: Cloudflare Turnstile site key (widget on login/register). Verify tokens server-side in production.
# VITE_TURNSTILE_SITE_KEY=

# Set to "true" to require confirmed email before accessing the app (enable "Confirm email" in Supabase Auth).
# VITE_REQUIRE_EMAIL_VERIFICATION=true
